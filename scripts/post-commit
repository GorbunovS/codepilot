#!/bin/sh
# codepilot post-commit hook: инкрементальное обновление индекса после коммита.
#
# Установка:
#   cp scripts/post-commit <repo>/.git/hooks/post-commit
#   chmod +x <repo>/.git/hooks/post-commit
#
# CODEPILOT — путь к бинарю (по умолчанию ищется в PATH).
# Индекс пишется в <repo>/index.db (SQLite); сбой индексации не отменяет коммит.

CODEPILOT=${CODEPILOT:-codepilot}
ROOT=$(git rev-parse --show-toplevel) || exit 0
"$CODEPILOT" index "$ROOT" >/dev/null 2>&1 || true
exit 0
